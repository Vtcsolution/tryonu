# Read by docker-compose.yml's `api` and `worker` services.
# DATABASE_URL / REDIS_URL / S3_* / PUBLIC_API_BASE_URL / CORS_ORIGINS /
# FRONTEND_URL are set directly in docker-compose.yml (they point at the
# other containers by service name) — everything else lives here.
#
# Ships with mock providers so `docker compose up --build` works with zero
# credentials. Fill in real keys for a real deployment; in a real
# production environment prefer your platform's secret manager over a
# committed file for SECRET_KEY / API keys.

ENV=production
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
COOKIE_SECURE=true

VIRTUAL_TRYON_PROVIDER=mock
FASHN_API_KEY=
FASHN_MODEL=tryon-v1.6

LLM_PROVIDER=mock
OPENAI_API_KEY=

PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
DARAZ_API_KEY=
