# Copy to .env and fill in for your environment.
# Every value below has a working local-dev default in app/core/config.py —
# you only need to set what you're actually turning on.

ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true

CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000

# --- database: Postgres in production, SQLite file for local dev ---
DATABASE_URL=postgresql+asyncpg://tryonu:tryonu@localhost:5432/tryonu

# --- redis / job queue (omit to fall back to the in-process runner) ---
REDIS_URL=redis://localhost:6379/0

# --- auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- object storage: S3 / Cloudflare R2 (omit to write to local disk) ---
# S3_ENDPOINT_URL / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY and the shorter
# S3_ENDPOINT / S3_ACCESS_KEY / S3_SECRET_KEY names are both accepted.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=tryonu-media
S3_REGION=auto
S3_PUBLIC_BASE_URL=

# --- AI: virtual try-on (omit FASHN_API_KEY to use the built-in mock provider) ---
VIRTUAL_TRYON_PROVIDER=fashn
FASHN_API_KEY=
FASHN_MODEL=tryon-v1.6

# --- AI: fashion stylist LLM (omit OPENAI_API_KEY to use the mock provider) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# --- payments (omit STRIPE_SECRET_KEY to use the mock provider) ---
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- email (omit SMTP_HOST to use the mock provider, which logs instead of sending) ---
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@tryonu.app
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440

# --- product catalog: real retailers (omit any pair to skip that retailer —
# the sync just logs "retailer_skipped" and continues with the rest) ---
# eBay Browse API — https://developer.ebay.com/my/keys (a Browse API keyset's
# App ID / Cert ID; no affiliate/business approval needed to start).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_CAMPAIGN_ID=
EBAY_MARKETPLACE_ID=EBAY_US
# Amazon Product Advertising API — requires an approved Associates account.
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
# Flipkart Affiliate API — requires an approved affiliate account.
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
# Daraz — requires an approved seller/affiliate API key.
DARAZ_API_KEY=
# CJ Affiliate (Commission Junction) GraphQL Product API — CJ developer
# portal > Account > API Keys for CJ_API_TOKEN (a Personal Access Token);
# CJ_WEBSITE_ID is CJ's own "Company ID" (companyId) for your publisher
# account, in the CJ dashboard. Both required — companyId is a
# non-nullable argument on CJ's products query (verified via live schema
# introspection against https://ads.api.cj.com/query). CJ's own tracked
# link (linkCode.clickUrl) is used directly — no separate affiliate-link
# wrapping step, unlike eBay's campid or Amazon's tag scheme.
CJ_API_TOKEN=
CJ_WEBSITE_ID=
# Rakuten Advertising — architecture built and live-verified (see
# app/retailers/rakuten.py: auth, Product Search XML parsing, and the
# Advertisers v2 JSON endpoint all confirmed against a real account).
# Stays fully inert until RAKUTEN_ENABLED=true AND credentials are set —
# the sync then just logs "retailer_skipped" and continues with everything
# else, exactly like every other retailer here.
# Either RAKUTEN_CLIENT_ID+RAKUTEN_CLIENT_SECRET (OAuth2 client_credentials)
# OR a directly-issued RAKUTEN_TOKEN (+ RAKUTEN_REFRESH_TOKEN) works —
# whichever your Rakuten account setup actually issues.
RAKUTEN_ENABLED=false
RAKUTEN_CLIENT_ID=
RAKUTEN_CLIENT_SECRET=
RAKUTEN_TOKEN=
RAKUTEN_REFRESH_TOKEN=
RAKUTEN_PUBLISHER_ID=
RAKUTEN_ACCOUNT_ID=
# Confirmed live: api.rakutenmarketing.com does not resolve at all;
# api.linksynergy.com is Rakuten Advertising's real, working API host.
RAKUTEN_API_BASE_URL=https://api.linksynergy.com

# --- affiliate networks ---
# Awin application submitted, awaiting approval — do NOT invent credentials
# here. Until real credentials exist, only the built-in "direct" network
# (plain ?ref=tryonu links, always active) is used; awin/impact stay
# unconfigured and inactive. (CJ is handled above as a retailer/product
# source, not here — see the note on CJ_API_TOKEN/CJ_WEBSITE_ID.)
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
