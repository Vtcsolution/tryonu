# Copy to .env and fill in for your environment.
# Every value below has a working local-dev default in app/core/config.py —
# you only need to set what you're actually turning on.

ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true

CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000

# --- database: Postgres in production, SQLite file for local dev ---
DATABASE_URL=postgresql+asyncpg://tryonu:tryonu@localhost:5432/tryonu

# --- redis / job queue (omit to fall back to the in-process runner) ---
REDIS_URL=redis://localhost:6379/0

# --- auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- object storage: S3 / Cloudflare R2 (omit to write to local disk) ---
# S3_ENDPOINT_URL / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY and the shorter
# S3_ENDPOINT / S3_ACCESS_KEY / S3_SECRET_KEY names are both accepted.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=tryonu-media
S3_REGION=auto
S3_PUBLIC_BASE_URL=

# --- AI: virtual try-on (omit FASHN_API_KEY to use the built-in mock provider) ---
VIRTUAL_TRYON_PROVIDER=fashn
FASHN_API_KEY=
FASHN_MODEL=tryon-v1.6

# --- AI: fashion stylist LLM (omit OPENAI_API_KEY to use the mock provider) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# --- payments (omit STRIPE_SECRET_KEY to use the mock provider) ---
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- email (omit SMTP_HOST to use the mock provider, which logs instead of sending) ---
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@tryonu.app
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- affiliate networks ---
# Awin application submitted, awaiting approval — do NOT invent credentials
# here. Until real credentials exist, only the built-in "direct" network
# (plain ?ref=tryonu links, always active) is used; awin/cj/impact stay
# unconfigured and inactive.
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=
CJ_API_TOKEN=
CJ_WEBSITE_ID=
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
